/**
 * AIO Initiative — bulk-import the module decks into Google Slides
 * and write a spreadsheet of the resulting links.
 *
 * GENERATED by scripts/slides/make_apps_script.py — re-run that after
 * rebuilding the decks rather than editing the MODULES table by hand.
 *
 * ── Setup ──────────────────────────────────────────────────────────────
 * 1. Make a Drive folder and upload every .pptx from the repo's slides/
 *    folder into it (select all 55, drag them in at once).
 * 2. Open the folder and copy the id out of the URL:
 *       drive.google.com/drive/folders/THIS_PART_HERE
 * 3. script.google.com -> New project -> paste this whole file in.
 * 4. Put the id into FOLDER_ID below, then Run -> importDecks.
 *    Approve the permission prompt on the first run.
 *
 * The script prints the spreadsheet URL in the execution log and also
 * leaves the sheet in the same Drive folder.
 *
 * It is safe to re-run. Anything already converted is reused rather than
 * duplicated, so if the 6-minute execution limit cuts a run short, just
 * run it again and it picks up where it stopped.
 *
 * Already flipped on Drive's "convert uploads to Google editor format"
 * setting? Then the files arrived as Slides already — this script detects
 * that, skips conversion, and just collects the links.
 */

const FOLDER_ID = 'PASTE_YOUR_FOLDER_ID_HERE';
const SHEET_NAME = 'AIO Initiative — Module Slides';

const SLIDES_MIME = 'application/vnd.google-apps.presentation';

function importDecks() {
  if (FOLDER_ID === 'PASTE_YOUR_FOLDER_ID_HERE') {
    throw new Error('Set FOLDER_ID to your Drive folder id first (step 2 above).');
  }
  const folder = DriveApp.getFolderById(FOLDER_ID);

  // Index what is already in the folder, by base name.
  const pptx = {}, slides = {};
  const it = folder.getFiles();
  while (it.hasNext()) {
    const f = it.next();
    const base = f.getName().replace(/\.pptx$/i, '');
    if (f.getMimeType() === SLIDES_MIME) slides[base] = f;
    else if (/\.pptx$/i.test(f.getName())) pptx[base] = f;
  }

  const rows = [];
  let converted = 0, reused = 0, missing = 0;

  MODULES.forEach(function (m) {
    const base = m.file.replace(/\.pptx$/i, '');
    let file = slides[base];

    if (file) {
      reused++;
    } else if (pptx[base]) {
      file = convertToSlides(pptx[base], base, folder);
      slides[base] = file;
      converted++;
    } else {
      missing++;
      Logger.log('MISSING in folder: ' + m.file);
    }

    rows.push([
      m.stage,
      m.code,
      m.title,
      m.slides,
      file ? file.getUrl() : '— not uploaded —',
      m.page
    ]);
  });

  const url = writeSheet(rows, folder);
  Logger.log('converted: %s   already Slides: %s   missing: %s', converted, reused, missing);
  Logger.log('SPREADSHEET: %s', url);
  return url;
}

/** Copy a .pptx into Drive as a native Google Slides deck. */
function convertToSlides(file, name, folder) {
  const res = UrlFetchApp.fetch(
    'https://www.googleapis.com/drive/v3/files/' + file.getId() + '/copy?supportsAllDrives=true',
    {
      method: 'post',
      contentType: 'application/json',
      headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
      payload: JSON.stringify({
        name: name,
        mimeType: SLIDES_MIME,
        parents: [folder.getId()]
      }),
      muteHttpExceptions: true
    });
  if (res.getResponseCode() >= 300) {
    throw new Error('Convert failed for ' + name + ': ' + res.getContentText());
  }
  return DriveApp.getFileById(JSON.parse(res.getContentText()).id);
}

function writeSheet(rows, folder) {
  const ss = SpreadsheetApp.create(SHEET_NAME);
  const sheet = ss.getSheets()[0];
  const header = ['Stage', 'Code', 'Module', 'Slides', 'Google Slides link', 'Module page'];

  sheet.getRange(1, 1, 1, header.length).setValues([header])
    .setFontWeight('bold').setBackground('#5b21b6').setFontColor('#ffffff');
  sheet.getRange(2, 1, rows.length, header.length).setValues(rows);

  sheet.setFrozenRows(1);
  sheet.setColumnWidth(1, 90);
  sheet.setColumnWidth(2, 60);
  sheet.setColumnWidth(3, 320);
  sheet.setColumnWidth(4, 60);
  sheet.setColumnWidth(5, 420);
  sheet.setColumnWidth(6, 420);
  sheet.getRange(2, 4, rows.length, 1).setHorizontalAlignment('center');

  // Park the sheet next to the decks instead of loose in My Drive.
  DriveApp.getFileById(ss.getId()).moveTo(folder);
  return ss.getUrl();
}

